# Copy this file to .env and adjust. Empty value = default. See README for details.

# --- What to read ---
# Mailbox in your Outlook profile (display name / email address). Empty = default mailbox.
OUTLOOK_MAILBOX=
# Subfolder under Inbox to read. Empty = read the Inbox itself.
OUTLOOK_SUBFOLDER=
MAX_EMAILS=50
DAYS_BACK=7

# --- Output ---
OUTPUT_FILE=email_report.xlsx
SKIP_ALREADY_ANALYZED=true
# true writes an "AI: <Category>" Outlook category onto analyzed mails (only option that modifies mail).
APPLY_OUTLOOK_CATEGORIES=false

# --- Claude ---
# Model name for the Claude Code CLI. Empty = Claude Code default.
CLAUDE_MODEL=
USE_CLAUDE=true
CLAUDE_BATCH_SIZE=5
CLAUDE_WORKERS=4

# --- Learning from your own categories ---
# Outlook categories to ignore when learning (comma-separated).
EXCLUDE_CATEGORIES=Follow up
PROFILE_MAX_AGE_DAYS=7
LEARN_MAX_ITEMS=5000
SENDER_RULE_MIN_MAILS=3
SENDER_RULE_MIN_SHARE=0.9
PROFILE_EXAMPLES=0
MODEL_TARGET_PRECISION=0.9

# --- "Can be archived" detection (clear ARCHIVE_CATEGORY to turn it off) ---
# Name of the folder you move finished/unimportant mails to, and the category flagged for such mails.
ARCHIVE_FOLDER=Archive
ARCHIVE_CATEGORY=Can be archived
ARCHIVE_MAX_ITEMS=3000
ARCHIVE_MIN_SENDER_MAILS=3
ARCHIVE_SENDER_GUARD=false
ARCHIVE_TRAIN_SAMPLES=900
MODEL_ARCHIVE_MAX_FALSE=0.01

# --- Evaluation ---
EVAL_SAMPLE=40
